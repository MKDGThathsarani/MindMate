{
  "env": {
    "react-native/react-native": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "@react-native/eslint-config"
  ],
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off"
  }
}
